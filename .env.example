# ── Docker image tags ────────────────────────────────────────────────────────
IMAGE_TAG=latest
PREV_IMAGE_TAG=latest

# ── Windows host path (use forward slashes) ──────────────────────────────────
# Set this to the folder where docker-compose.yml lives on your Windows machine.
# Example:  C:/Users/sejal/Downloads/VulcanPaas_AI_DevOps_Platform/VulcanPaas_AI_DevOps_Platform-main
PROJECT_ROOT=C:/Users/sejal/Downloads/VulcanPaas_AI_DevOps_Platform/VulcanPaas_AI_DevOps_Platform-main

# ── GitHub (optional — enables auto webhook injection & AI reviews) ───────────
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── Public URL that GitHub will POST webhooks to ─────────────────────────────
# Use ngrok or similar to expose port 80 if testing GitHub webhooks locally.
# Example: https://abc123.ngrok.io/webhook/github
WEBHOOK_URL=http://your-public-url/webhook/github

# ── DeepSeek AI (optional — enables AI code reviews & chatbot) ───────────────
DEEPSEEK_API_KEY=your_deepseek_key_here
